{
  "name": "lebanon-pos-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ./src/generated ./src/index.ts",
    "build": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.11.0",
    "prisma": "^6.5.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.12.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vercel/ncc": "^0.38.4",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}

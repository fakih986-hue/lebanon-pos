generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Admin
  Manager
  Cashier
  Driver
}

enum ShiftStatus {
  Open
  Closed
}

enum SaleStatus {
  Completed
  Debt
  Voided
}

enum SalePaymentMethod {
  Cash
  Card
  Wallet
  Debt
}

enum RefundMethod {
  Cash
  Card
  Wallet
  Debt_Credit
}

enum PurchaseOrderStatus {
  Draft
  Received
  Closed
}

enum PaymentStatus {
  Unpaid
  Partial
  Paid
}

enum InventoryBatchStatus {
  Open
  Consumed
  Expired
}

enum StockCountStatus {
  Draft
  Completed
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  subdomain   String   @unique
  suspended   Boolean  @default(false)
  cloudApiKey String   @default("")   // per-tenant sync key, generated at create
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users               StaffUser[]
  products            Product[]
  sales               Sale[]
  refunds             SaleRefund[]
  customers           Customer[]
  debtSales           DebtSale[]
  debtPayments        DebtPayment[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderItems  PurchaseOrderItem[]
  supplierPayments    SupplierPayment[]
  shifts              Shift[]
  auditEvents         AuditEvent[]
  settings            AppSettings?
  expenses            Expense[]
  inventoryBatches    InventoryBatch[]
  stockAdjustments    StockAdjustment[]
  stockCounts         StockCountSession[]
  dailyCloses         DailyClose[]
  syncOperations      SyncOperation[]
  deliveryOrders      DeliveryOrder[]
  stockMovements      StockMovement[]
}

model StaffUser {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  mobile    String
  code      String   @default("")
  pin       String
  pinVersion Int     @default(1)
  tokenVersion Int   @default(1)
  role      UserRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, mobile])
  @@index([tenantId, code])

  openedShifts    Shift[]          @relation("ShiftOpener")
  closedShifts    Shift[]          @relation("ShiftCloser")
  expenses        Expense[]
  deliveryOrders  DeliveryOrder[]  @relation("DeliveryDriver")
}

model AppSettings {
  id               String  @id @default(uuid())
  tenantId         String  @unique
  tenant           Tenant  @relation(fields: [tenantId], references: [id])
  storeName        String
  branchName       String
  phone            String
  address          String
  vatRate          Decimal @db.Decimal(10, 6)
  usdToLbpRate     Decimal @db.Decimal(18, 4)
  receiptFooter    String
  lowStockThreshold Int
  deliveryFee      Decimal @default(2.0) @db.Decimal(18, 4)
  whatsAppAdmin    String  @default("")
  whatsAppDriverEnabled Boolean @default(false)
  assignMode       String  @default("manual")
  assignTimeout    Int     @default(5)
  defaultDriverId  String  @default("")
}

model Product {
  id              Int       @id @default(autoincrement())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  parentId        Int?
  parent          Product?  @relation("ProductVariants", fields: [parentId], references: [id])
  variants        Product[] @relation("ProductVariants")
  isParent        Boolean   @default(false)
  variantName     String?
  name            String
  price           Decimal   @db.Decimal(18, 4)
  wholesalePrice  Decimal?  @db.Decimal(18, 4)
  cost            Decimal   @default(0) @db.Decimal(18, 4)
  stock           Float     @default(0)   // quantity — stays Float
  barcode         String?
  barcodeAliases  String[]
  category        String
  accent          String    @default("emerald")
  favorite        Boolean   @default(false)
  reorderPoint    Int?
  reorderQuantity Int?
  supplierId      String?
  supplierName    String?
  expiryDate      String?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  batches          InventoryBatch[]
  adjustments      StockAdjustment[]
  stockCountLines  StockCountLine[]
  stockMovements   StockMovement[]

  @@unique([tenantId, barcode])
  @@index([tenantId, category])
  @@index([tenantId, name])
  @@index([tenantId, parentId])
}

model Sale {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  saleNumber    String
  paymentMethod SalePaymentMethod
  customerId    String?
  customerName  String?
  subtotal      Decimal          @db.Decimal(18, 4)
  discountTotal Decimal?         @db.Decimal(18, 4)
  tax           Decimal          @db.Decimal(18, 4)
  total         Decimal          @db.Decimal(18, 4)
  cost          Decimal          @default(0) @db.Decimal(18, 4)
  profit        Decimal          @default(0) @db.Decimal(18, 4)
  soldAtCost    Boolean          @default(false)
  cashier       String
  cashierId     String?
  shiftId       String?
  shiftNumber   String?
  status        SaleStatus       @default(Completed)
  createdAt     DateTime         @default(now())

  items      SaleItem[]
  refunds    SaleRefund[]
  tender     SaleTender?

  @@unique([tenantId, saleNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, status, createdAt])
}

model SaleItem {
  id       String  @id @default(uuid())
  saleId   String
  sale     Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  productName String
  barcode   String
  quantity  Float                    // quantity — stays Float
  unitPrice Decimal @db.Decimal(18, 4)
  total     Decimal @db.Decimal(18, 4)
  cost      Decimal @default(0) @db.Decimal(18, 4)

  @@index([productId])
}

model SaleTender {
  id             String  @id @default(uuid())
  saleId         String  @unique
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  currency       String
  exchangeRate   Decimal @db.Decimal(18, 4)
  paidUsd        Decimal @default(0) @db.Decimal(18, 4)
  paidLbp        Decimal @default(0) @db.Decimal(18, 4)
  paidTotalUsd   Decimal @db.Decimal(18, 4)
  paidTotalLbp   Decimal @db.Decimal(18, 4)
  changeUsd      Decimal @default(0) @db.Decimal(18, 4)
  changeLbp      Decimal @default(0) @db.Decimal(18, 4)
  changeCurrency String
}

model SaleRefund {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  refundNumber String
  saleId       String
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleNumber   String
  customerId   String?
  customerName String?
  method       RefundMethod
  reason       String
  total        Decimal      @db.Decimal(18, 4)
  cashier      String
  cashierId    String?
  shiftId      String?
  shiftNumber  String?
  createdAt    DateTime     @default(now())

  items RefundItem[]

  @@unique([tenantId, refundNumber])
  @@index([tenantId, saleId])
}

model RefundItem {
  id          String     @id @default(uuid())
  refundId    String
  refund      SaleRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  productId   Int
  productName String
  barcode     String
  quantity    Float                         // quantity — stays Float
  unitPrice   Decimal    @db.Decimal(18, 4)
  cost        Decimal?   @db.Decimal(18, 4)
  total       Decimal    @db.Decimal(18, 4)
}

model Customer {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  mobile      String
  pin         String   @default("")
  creditLimit Decimal  @default(0) @db.Decimal(18, 4)
  isWholesale  Boolean  @default(false)
  sellAtCost   Boolean  @default(false)
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  debtSales     DebtSale[]
  debtPayments  DebtPayment[]
  deliveryOrders DeliveryOrder[]

  @@unique([tenantId, name])
  @@index([tenantId, mobile])
}

model DebtSale {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  saleNumber    String
  subtotal      Decimal  @db.Decimal(18, 4)
  discountTotal Decimal? @db.Decimal(18, 4)
  tax           Decimal  @db.Decimal(18, 4)
  total         Decimal  @db.Decimal(18, 4)
  createdAt     DateTime @default(now())

  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}

model DebtPayment {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  amount      Decimal  @db.Decimal(18, 4)
  method      String
  reference   String   @default("")
  createdAt   DateTime @default(now())

  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  mobile    String   @default("")
  contact   String   @default("")
  address   String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  supplierPayments SupplierPayment[]
  inventoryBatches InventoryBatch[]

  @@unique([tenantId, name])
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  poNumber      String
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  supplierName  String
  status        PurchaseOrderStatus @default(Draft)
  paymentStatus PaymentStatus       @default(Unpaid)
  invoiceNumber String              @default("")
  note          String              @default("")
  total         Decimal             @db.Decimal(18, 4)
  paidTotal     Decimal             @default(0) @db.Decimal(18, 4)
  createdBy     String
  shiftId       String?
  shiftNumber   String?
  createdAt     DateTime            @default(now())
  receivedAt    DateTime?

  items PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productName     String
  barcode         String        @default("")
  quantity        Float
  unitCost        Decimal       @default(0) @db.Decimal(18, 4)
  unitPrice       Decimal       @default(0) @db.Decimal(18, 4)
  total           Decimal       @db.Decimal(18, 4)

  @@index([tenantId, purchaseOrderId])
}

model SupplierPayment {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  supplierId          String
  supplier            Supplier @relation(fields: [supplierId], references: [id])
  supplierName        String
  purchaseOrderId     String?
  purchaseOrderNumber String?
  amount              Decimal  @db.Decimal(18, 4)
  method              String
  reference           String   @default("")
  recordedBy          String
  shiftId             String?
  shiftNumber         String?
  createdAt           DateTime @default(now())

  @@index([tenantId, supplierId])
}

model Shift {
  id                String      @id @default(uuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  shiftNumber       String
  status            ShiftStatus @default(Open)
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  openingFloatUsd   Decimal?    @default(0) @db.Decimal(18, 4)
  cashSalesUsd      Decimal?    @db.Decimal(18, 4)
  cashRefundsUsd    Decimal?    @db.Decimal(18, 4)
  cashExpensesUsd   Decimal?    @db.Decimal(18, 4)
  supplierPaymentsUsd Decimal?  @db.Decimal(18, 4)
  expectedCashUsd   Decimal?    @db.Decimal(18, 4)
  closingCashUsd    Decimal?    @db.Decimal(18, 4)
  differenceUsd     Decimal?    @db.Decimal(18, 4)
  openedById        String
  openedByName      String
  openedBy          StaffUser   @relation("ShiftOpener", fields: [openedById], references: [id])
  closedById        String?
  closedByName      String?
  closedBy          StaffUser?  @relation("ShiftCloser", fields: [closedById], references: [id])
  notes             String?

  @@unique([tenantId, shiftNumber])
  @@index([tenantId, status])
}

model AuditEvent {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  action    String
  entity    String
  summary   String
  metadata  Json?
  userId    String
  userName  String
  userRole  UserRole
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
}

model Expense {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  expenseNumber String
  vendor        String
  category      String
  amount        Decimal  @db.Decimal(18, 4)
  paymentMethod String
  invoiceNumber String   @default("")
  note          String   @default("")
  recordedBy    String
  recordedById  String?
  recordedByUser StaffUser? @relation(fields: [recordedById], references: [id])
  shiftId       String?
  shiftNumber   String?
  createdAt     DateTime @default(now())

  @@unique([tenantId, expenseNumber])
  @@index([tenantId, createdAt])
}

model InventoryBatch {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  batchNumber         String
  productId           Int
  product             Product              @relation(fields: [productId], references: [id])
  productName         String
  barcode             String
  initialQuantity     Float                     // quantity — stays Float
  quantityRemaining   Float                     // quantity — stays Float
  unitCost            Decimal  @db.Decimal(18, 4)
  unitPrice           Decimal  @db.Decimal(18, 4)
  expiryDate          String?
  supplierId          String?
  supplier            Supplier?            @relation(fields: [supplierId], references: [id])
  supplierName        String?
  purchaseOrderNumber String?
  receivedAt          DateTime             @default(now())
  status              InventoryBatchStatus @default(Open)

  @@index([tenantId, productId])
  @@index([tenantId, status])
}

model StockAdjustment {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  adjustmentNumber  String
  productId         Int
  product           Product  @relation(fields: [productId], references: [id])
  productName       String
  barcode           String
  quantityBefore    Float                     // quantity — stays Float
  quantityChange    Float                     // quantity — stays Float
  quantityAfter     Float                     // quantity — stays Float
  reason            String
  note              String?
  batchId           String?
  valueImpact       Decimal  @db.Decimal(18, 4)
  createdAt         DateTime @default(now())

  @@unique([tenantId, adjustmentNumber])
  @@index([tenantId, productId])
}

model StockCountSession {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  countNumber     String
  status          StockCountStatus @default(Draft)
  createdAt       DateTime         @default(now())
  completedAt     DateTime?
  totalVariance    Decimal @default(0) @db.Decimal(18, 4)
  totalValueImpact Decimal @default(0) @db.Decimal(18, 4)

  lines StockCountLine[]

  @@unique([tenantId, countNumber])
}

model StockCountLine {
  id               String           @id @default(uuid())
  sessionId        String
  session          StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product          @relation(fields: [productId], references: [id])
  productName      String
  barcode          String
  category         String
  expectedQuantity Float                          // quantity — stays Float
  countedQuantity  Float?                         // quantity — stays Float
  variance         Float            @default(0)   // quantity variance — stays Float
  valueImpact      Decimal          @default(0) @db.Decimal(18, 4)
}

enum DeliveryOrderStatus {
  Pending
  Confirmed
  Preparing
  OutForDelivery
  Delivered
  Cancelled
}

model DeliveryOrder {
  id              String               @id @default(uuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  orderNumber     String
  status          DeliveryOrderStatus  @default(Pending)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String
  address         String
  locationLat     Float?
  locationLng     Float?
  deliveryNote    String               @default("")
  itemsTotal      Decimal              @db.Decimal(18, 4)
  deliveryFee     Decimal              @default(0) @db.Decimal(18, 4)
  total           Decimal              @db.Decimal(18, 4)
  paymentMethod   String               @default("CashOnDelivery")
  paidAmount      Decimal              @default(0) @db.Decimal(18, 4)
  changeRequired  Decimal              @default(0) @db.Decimal(18, 4)
  assignedTo      String?
  assignedName    String?
  driverId        String?
  driver          StaffUser?           @relation("DeliveryDriver", fields: [driverId], references: [id])
  driverAssignedAt DateTime?
  notes           String               @default("")
  cancelledReason String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  items DeliveryOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model DeliveryOrderItem {
  id              String        @id @default(uuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  productId       Int
  productName     String
  barcode         String
  quantity        Float
  unitPrice       Decimal @db.Decimal(18, 4)
  total           Decimal @db.Decimal(18, 4)
}

model DailyClose {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  dateKey         String
  grossSales      Decimal   @db.Decimal(18, 4)
  refunds         Decimal   @default(0) @db.Decimal(18, 4)
  netSales        Decimal   @db.Decimal(18, 4)
  costOfGoods     Decimal   @default(0) @db.Decimal(18, 4)
  returnedCost    Decimal   @default(0) @db.Decimal(18, 4)
  grossMargin     Decimal   @default(0) @db.Decimal(18, 4)
  expenses        Decimal   @default(0) @db.Decimal(18, 4)
  supplierPayments Decimal? @db.Decimal(18, 4)
  netProfit       Decimal   @default(0) @db.Decimal(18, 4)
  cashIn          Decimal   @default(0) @db.Decimal(18, 4)
  cashOut         Decimal   @default(0) @db.Decimal(18, 4)
  note            String   @default("")
  closedBy        String
  createdAt       DateTime @default(now())

  @@unique([tenantId, dateKey])
}

model SyncOperation {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  entity        String
  action        String
  summary       String
  payload       Json?
  status        String   @default("Pending")
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
  lastAttemptAt DateTime?
  syncedAt      DateTime?
  error         String?

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, entity, status])
}

model RateLimitEntry {
  id      String   @id @default(uuid())
  bucket  String
  key     String
  count   Int      @default(1)
  resetAt DateTime

  @@unique([bucket, key])
  @@index([resetAt])
}

model StockMovement {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  type       String   // Receive | Sale | Refund | Adjustment | WriteOff
  quantity   Float
  balance    Float    // running balance after this movement
  reference  String   // sale ID, batch ID, adjustment ID, etc.
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
}

  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  orderNumber     String
  status          DeliveryOrderStatus  @default(Pending)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String
  address         String
  locationLat     Float?
  locationLng     Float?
  deliveryNote    String               @default("")
  itemsTotal      Decimal              @db.Decimal(18, 4)
  deliveryFee     Decimal              @default(0) @db.Decimal(18, 4)
  total           Decimal              @db.Decimal(18, 4)
  paymentMethod   String               @default("CashOnDelivery")
  paidAmount      Decimal              @default(0) @db.Decimal(18, 4)
  changeRequired  Decimal              @default(0) @db.Decimal(18, 4)
  assignedTo      String?
  assignedName    String?
  driverId        String?

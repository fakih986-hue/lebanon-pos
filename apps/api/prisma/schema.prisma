  total           Decimal @db.Decimal(18, 4)
}

model DailyClose {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  dateKey         String
  grossSales      Decimal   @db.Decimal(18, 4)
  refunds         Decimal   @default(0) @db.Decimal(18, 4)
  netSales        Decimal   @db.Decimal(18, 4)
  /// Cost figures: null = unknown (never stored as 0). costStatus says where they come from:
  /// "server" (computed here from the sales and refunds the close counted), "complete" (stated by a
  /// cost-visible till), "incomplete" (not known). Null costStatus: recorded before it existed.
  costOfGoods     Decimal?  @db.Decimal(18, 4)
  returnedCost    Decimal?  @db.Decimal(18, 4)
  grossMargin     Decimal?  @db.Decimal(18, 4)
  expenses        Decimal   @default(0) @db.Decimal(18, 4)
  supplierPayments Decimal? @db.Decimal(18, 4)
  netProfit       Decimal?  @db.Decimal(18, 4)
  costStatus      String?
  cashIn          Decimal   @default(0) @db.Decimal(18, 4)
  cashOut         Decimal   @default(0) @db.Decimal(18, 4)
  note            String   @default("")
  closedBy        String
  closedById      String?
  /// Operational readiness (lib/attribution.ts): how the actor of this record is known — { basis: verified |
  /// offline-claimed | claimed | reviewed | system | unattributed, approver?, reviewer?, opId }. Written by the
  /// server when it applies the operation (never taken from the client); null for records made before it existed.
  attribution   Json?
  unsyncedCountAtClose Int?
  createdAt       DateTime @default(now())
  /// Which close this is (lib/dailyClose.ts): a date may have several — one per register and shift
  /// (`scope`; "store" for closes recorded before scopes, or by a register that sends none). Within a
  /// scope, a correction is a new revision linked to the one it corrects; the corrected close is kept
  /// (supersededById). Reports use the current revision of each scope (supersededById null).
  scope           String    @default("store")
  registerId      String?
  shiftId         String?
  revision        Int       @default(1)
  revisionOf      String?
  /// "correction" (the register named the close it corrects) or "re-close" (a register that cannot name
  /// it closed the same scope again); null for a first close.
  correction      String?
  supersededById  String?
  supersededAt    DateTime?

  @@unique([tenantId, dateKey, scope, revision])
  @@index([tenantId, dateKey])
}

model CashMovement {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  shiftId       String?
  shiftNumber   String?
  type          String   // CashIn | CashOut | SafeDrop | DrawerCorrection | PettyCash
  direction     String   @default("Out")  // In | Out
  amountUsd     Decimal  @db.Decimal(18, 4)
  reason        String
  note          String   @default("")
  referenceEntity String? // e.g. "sale", "supplier-payment"
  referenceId   String?
  recordedById  String?
  recordedByName String
  /// Operational readiness (lib/attribution.ts): how the actor of this record is known — { basis: verified |
  /// offline-claimed | claimed | reviewed | system | unattributed, approver?, reviewer?, opId }. Written by the
  /// server when it applies the operation (never taken from the client); null for records made before it existed.
  attribution   Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, shiftId])
  @@index([tenantId, type])
}

model SyncOperation {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  entity        String
  action        String
  summary       String
  payload       Json?
  status        String   @default("Pending")
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
  lastAttemptAt DateTime?
  syncedAt      DateTime?
  error         String?
  /// When this server applied the operation's effects (SYNC-DEDUPE-2). Separate from `status`,
  /// which tracks onward delivery to the cloud (Pending = to forward, Synced = forwarded).
  appliedAt     DateTime?
  /// Applied under server valuation (1.0.52+): the figures it carries are this server's. A hub
  /// forwards it with ev.valued = "server"; the cloud values any operation without it itself.
  serverValued  Boolean  @default(false)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, entity, status])
  /// SPRINT-2 F: what this server knew when it held the operation for review (actor, device, session,
  /// approval and attestation checks, evidence label). Never a token or a PIN. Kept with the command.
  heldEvidence Json?
}

model Device {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  deviceId    String
  deviceName  String   @default("")
  registerId  String   @default("")
  status      String   @default("APPROVED")     // APPROVED | REVOKED
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  lastIp      String   @default("")
  /// SPRINT-2 C: enrollment. A device credential is valid only while its version matches and the
  /// device is APPROVED; re-enrolling or revoking bumps the version.
  credentialVersion Int     @default(0)
  enrolledAt        DateTime?
  enrolledById      String?   // staff member who created the enrollment code

  @@unique([tenantId, deviceId])
  @@index([tenantId])
}

model PairingCode {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  code      String    @unique
  deviceId  String?
  deviceName String   @default("")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdById String?  // SPRINT-2 C: the staff member who created it

  @@index([tenantId])
  @@index([code])
}

model RateLimitEntry {
  id      String   @id @default(uuid())
  bucket  String
  key     String
  count   Int      @default(1)
  resetAt DateTime

  @@unique([bucket, key])
  @@index([resetAt])
}

model StockMovement {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  type       String   // Receive | Sale | Refund | Adjustment | WriteOff | Opening
  quantity   Float
  balance    Float    // advisory running balance after this movement (truth = sum(quantity))
  reference  String   // sale ID, batch ID, adjustment ID, opening:<x>, delivery:<orderId>, etc.
  note       String   @default("")
  // POS-SYNC-AUTHORITY-2A — additive source/attribution + batch link (all nullable, record-only)
  batchId    String?
  deviceId   String?
  userId     String?
  userName   String?
  createdAt  DateTime @default(now())

  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  // Non-unique lookup/idempotency index (unique constraint deliberately deferred)
  @@index([tenantId, reference, type, productId])
}

/// SPRINT-1: a sync client of a store (till by device id, hub bridge by "hub-bridge@<schema>") and the
/// sync schema it last pushed with — the store-wide upgrade gate for stock-policy changes.
model SyncClient {
  id          String    @id @default(uuid())
  tenantId    String
  clientKey   String
  label       String    @default("")
  syncSchema  Int       @default(1)
  lastSeenAt  DateTime  @default(now())
  retiredAt   DateTime?
  retiredBy   String?
  retiredNote String?
  /// What the register last reported about its own queue (pending, held, failed, staged, journal) and when
  queueReport     Json?
  queueReportedAt DateTime?

  @@unique([tenantId, clientKey])
  @@index([tenantId, syncSchema, lastSeenAt])
}

/// SPRINT-2 Phase B (observe mode): what the receiving server knows about each applied operation.
/// "claimed" columns come from the client and are not authenticated; evidence is never "verified"
/// until staff sessions exist (Phase C).
model OperationEvidence {
  opId                String   @id
  tenantId            String
  entity              String
  action              String
  receivedAt          DateTime @default(now())
  acceptedBy          String
  transport           String
  credentialKind      String
  connectionAccountId String?
  deviceIdClaimed     String?
  actorIdClaimed      String?
  actorNameClaimed    String?
  actorMatchesAccount Boolean?
  evidence            String
  limitations         String[] @default([])
  claimedAt           String?
  envelopeVersion     Int      @default(0)
  // SPRINT-2 C (observe): device credential and staff session presented with the operation, as
  // checked by this server when it received it. Not enforced.
  enrolledDeviceId    String?
  deviceCheck         String?  // valid | absent | invalid | revoked | superseded | other-store
  sessionId           String?
  sessionStaffId      String?
  sessionAuthTime     DateTime?
  sessionCheck        String?  // valid | absent | invalid | other-device | other-store | staff-inactive | staff-revoked | no-device
  /// What the hub that relayed this operation recorded: from its signed attestation when that verified,
  /// otherwise as the hub sent it (unattested).
  relayed             Json?
  /// SPRINT-2 D: the relaying hub's attestation as checked here: valid | absent | unknown-key | revoked |
  /// rotated | other-store | invalid-signature | op-mismatch | digest-mismatch. "valid" means an enrolled
  /// hub of this store signed this exact command and its own evidence: the hub vouched, not proof that a
  /// person entered a PIN.
  attestation         String?
  attestationKid      String?
  /// SPRINT-2 E: a manager approval presented with the operation, as checked by the server that
  /// received it from the register: { id, check, approverId, approverName, permission }. The actor stays
  /// the person who did it; the approver is recorded separately.
  approval            Json?
  /// Operational readiness: the attribution this server wrote on the business record (lib/attribution.ts);
  /// a hub forwards it signed, so the cloud records the same people.
  attribution         Json?

  @@index([tenantId, receivedAt])
  @@index([tenantId, evidence])
}

/// SPRINT-2 D: a hub's signing key (ES256), enrolled at the cloud by an owner-authorized request (the
/// store's cloud key alone cannot enroll one). One ACTIVE key per store; enrolling a new one rotates the
/// previous (still accepted for attestations it signed before rotation); a revoked key is never accepted.
model HubKey {
  kid          String    @id
  tenantId     String
  publicPem    String
  status       String    @default("ACTIVE") // ACTIVE | ROTATED | REVOKED
  enrolledById String
  enrolledAt   DateTime  @default(now())
  rotatedAt    DateTime?
  revokedAt    DateTime?
  revokedById  String?
  revokeNote   String?
  /// The hub installation this key belongs to (stable across key rotation; lib/topology.ts)
  hubId        String?
  hubLabel     String    @default("")
  /// The hub's latest signed status report (queue, held work, stock, policy and topology versions)
  lastReport   Json?
  lastReportAt DateTime?

  @@index([tenantId, status])
}

/// SPRINT-2 E: an online manager approval. The manager's PIN was checked by this server for ONE business
/// record (entity, action, record id) with these material values, on this enrolled register, for this
/// permission. Single use: the first operation that presents it within its lifetime uses it; only that
/// same operation may present it again (an exact retry). Never stores the PIN.
model ManagerApproval {
  id             String    @id
  tenantId       String
  deviceId       String    // Device.id of the enrolled register that asked
  entity         String
  action         String
  recordId       String
  materialDigest String
  material       Json
  permission     String
  /// every permission approved (one approval may cover a discount and a price below list together)
  permissions    String[]  @default([])
  approverId     String
  approverName   String
  requestedById  String?   // the person signed in on the register (session-checked when sessionChecked)
  sessionChecked Boolean   @default(false)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  usedByOpId     String?
  cancelledAt    DateTime?

  @@index([tenantId, deviceId])
  @@index([tenantId, recordId])
}

/// SPRINT-2 F: one reviewer's decision about one held operation (opId unique: decided once). Kept apart
/// from the operation, which stays as it was sent, with the evidence it was held with. `outcome` for a
/// decline says what the reviewer states about money: nothing to correct, a manual correction they
/// acknowledge (not proof), or money they attest was recovered (the reviewer's statement, not proof).
model ReviewResolution {
  id               String   @id @default(uuid())
  tenantId         String
  opId             String   @unique
  entity           String
  action           String
  decision         String   // apply | dismiss
  outcome          String   // applied | nothing-to-correct | manual-correction-acknowledged | money-recovered-attested
  category         String
  reviewerId       String
  reviewerName     String
  note             String
  previewToken     String
  originalReason   String?
  originalEvidence Json?
  money            Json?
  applyResult      String?
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// SPRINT-2 C: a staff session — the server verified this staff member's PIN for this enrolled device
/// at authTime. It proves nothing about later presence. Ended when the device switches person,
/// signs out, or the device is revoked.
model StaffSession {
  id        String    @id
  tenantId  String
  deviceId  String    // Device.id (server-assigned)
  staffId   String
  authTime  DateTime  @default(now())
  expiresAt DateTime
  endedAt   DateTime?
  endReason String?   // switched | signed-out | device-revoked

  @@index([tenantId, deviceId])
  @@index([tenantId, staffId])
}

/// Café batch: a modifier group (size, milk, sugar, shots, ice). The id is minted once by whoever creates it and
/// is the same on every server; its options (stable ids) live in `options`:
/// [{id, name, nameAr, priceDelta, isDefault, available, archived, sortOrder}]. Options are archived, never removed,
/// so sales that chose them keep displaying them.
model ModifierGroup {
  id        String   @id
  tenantId  String
  name      String
  nameAr    String   @default("")
  required  Boolean  @default(false)
  minSelect Int      @default(0)
  maxSelect Int      @default(1)
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  options   Json     @default("[]")
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, updatedAt])
}

/// Café batch: one immutable revision of a drink's recipe. Saving a recipe adds a revision (id minted once by
/// whoever saves it) and moves the product's recipeRev; old revisions stay, so sales made with them resolve.
/// lines: [{ingredientSyncId, quantity (stock units, at most 3 decimals), when: optionId[], unless: optionId[]}]
model RecipeRevision {
  id            String   @id
  tenantId      String
  productSyncId String
  yield         Int      @default(1)
  lines         Json     @default("[]")
  note          String   @default("")
  parentRev     String?
  createdById   String?
  createdByName String?
  attribution   Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, productSyncId])
  @@index([tenantId, createdAt])
}

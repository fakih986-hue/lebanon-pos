generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Admin
  Manager
  Cashier
  Driver
}

enum ShiftStatus {
  Open
  Closed
}

enum SaleStatus {
  Completed
  Debt
  Voided
}

enum SalePaymentMethod {
  Cash
  Card
  Wallet
  Debt
}

enum RefundMethod {
  Cash
  Card
  Wallet
  Debt_Credit
}

enum PurchaseOrderStatus {
  Draft
  Received
  Closed
}

enum PaymentStatus {
  Unpaid
  Partial
  Paid
}

enum InventoryBatchStatus {
  Open
  Consumed
  Expired
}

enum StockCountStatus {
  Draft
  Completed
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  subdomain   String   @unique
  suspended   Boolean  @default(false)
  cloudApiKey String   @default("")   // per-tenant sync key, generated at create

  // ── License / suspension system (v2) ────────────────────────────────
  licenseStatus     String   @default("active")  // active | grace | suspended | read_only | recovery
  licenseReason     String   @default("")        // admin-facing: why suspended/grace
  licenseMessage    String   @default("")        // user-facing: shown in POS overlay
  suspendedAt       DateTime?                    // when suspension started
  offlineGraceDays  Int      @default(7)         // days POS can work offline before locking
  leaseExpiresAt    DateTime?                    // when the offline lease expires
  policyVersion     Int      @default(1)         // increments on every license change — triggers desktop re-check
  /// SPRINT-2: staff identity enforcement for this store. "observe" (default: record evidence only) |
  /// "enforce-checkout" (ordinary sales need an enrolled device + a server-checked staff session) |
  /// "enforce" (every register operation and permission check is the session person's; lib/staffPolicy.ts).
  /// Changed only by an explicit, audited decision; never switched on automatically.
  staffSessionMode  String   @default("observe")
  /// The staff policy's version (lib/staffPolicy.ts): issued at the cloud, adopted by a hub only when higher.
  staffPolicyVersion  Int       @default(0)
  staffPolicyIssuedAt DateTime?
  staffPolicyIssuedBy String?
  /// Store topology (lib/topology.ts): "unset" (every store before it existed: no topology rule applies),
  /// "direct" (registers connect straight to the cloud; the cloud is the stock authority) or "hub" (registers
  /// connect through the hub `topologyHubId`, the stock authority; the cloud records what it forwards).
  /// Changed only by an explicit, audited owner decision after readiness checks; never by a connecting device.
  storeTopology     String    @default("unset")
  topologyHubId     String?
  topologyVersion   Int       @default(0)
  topologyChangedAt DateTime?
  topologyChangedBy String?

  // ── Subscription metadata (v2) ─────────────────────────────────────
  planName          String   @default("")        // free | basic | pro | enterprise
  trialStartDate    DateTime?                    // when trial started
  trialEndDate      DateTime?                    // when trial expires
  subscriptionStart DateTime?                    // when paid subscription started
  subscriptionEnd   DateTime?                    // when subscription expires
  renewalDate       DateTime?                    // next renewal date
  billingContact    String   @default("")        // owner email/phone for billing
  internalNotes     String   @default("")        // admin-only notes

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users               StaffUser[]
  products            Product[]
  sales               Sale[]
  refunds             SaleRefund[]
  customers           Customer[]
  debtSales           DebtSale[]
  debtPayments        DebtPayment[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderItems  PurchaseOrderItem[]
  supplierPayments    SupplierPayment[]
  shifts              Shift[]
  auditEvents         AuditEvent[]
  settings            AppSettings?
  expenses            Expense[]
  inventoryBatches    InventoryBatch[]
  stockAdjustments    StockAdjustment[]
  stockCounts         StockCountSession[]
  dailyCloses         DailyClose[]
  syncOperations      SyncOperation[]
  deliveryOrders      DeliveryOrder[]
  stockMovements      StockMovement[]
  cashMovements        CashMovement[]
  devices              Device[]
  pairingCodes         PairingCode[]
}

model StaffUser {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  mobile    String
  code      String   @default("")
  pin       String
  pinVersion Int     @default(1)
  tokenVersion Int   @default(1)
  /// Bumped by the server whenever role, permissions or active change: a staff update made on an
  /// older copy cannot change them (stale-device protection).
  roleVersion Int    @default(1)
  role      UserRole
  // POS-PERMISSIONS-1: explicit per-user permission set. Empty → the client and
  // server fall back to the role preset (backward compatible with pre-1.0.44).
  permissions String[] @default([])
  active    Boolean  @default(true)
  pinChanged Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, mobile])
  @@index([tenantId, code])

  openedShifts    Shift[]          @relation("ShiftOpener")
  closedShifts    Shift[]          @relation("ShiftCloser")
  expenses        Expense[]
  deliveryOrders  DeliveryOrder[]  @relation("DeliveryDriver")
}

model AppSettings {
  id               String  @id @default(uuid())
  tenantId         String  @unique
  tenant           Tenant  @relation(fields: [tenantId], references: [id])
  storeName        String
  branchName       String
  phone            String
  address          String
  vatRate          Decimal @db.Decimal(10, 6)
  usdToLbpRate     Decimal @db.Decimal(18, 4)
  receiptFooter    String
  lowStockThreshold Int
  profitPercent1   Decimal @default(25) @db.Decimal(6, 2)
  profitPercent2   Decimal @default(35) @db.Decimal(6, 2)
  deliveryFee      Decimal @default(2.0) @db.Decimal(18, 4)
  whatsAppAdmin    String  @default("")
  whatsAppDriverEnabled Boolean @default(false)
  assignMode       String  @default("manual")
  assignTimeout    Int     @default(5)
  defaultDriverId  String  @default("")
}

model Product {
  id              Int       @id @default(autoincrement())
  // Stable cross-system sync identity (see packages/types Product.syncId).
  // Numeric `id` stays the local/internal PK + FK target; `syncId` is the
  // globally stable identity matched across hub/client/cloud. Nullable during
  // the transition (legacy rows backfilled cloud-authoritatively); unique per
  // tenant. Nullable-unique is safe in Postgres — NULLs are treated as
  // distinct, so many not-yet-backfilled rows coexist without collision.
  syncId          String?
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  parentId        Int?
  parent          Product?  @relation("ProductVariants", fields: [parentId], references: [id])
  variants        Product[] @relation("ProductVariants")
  isParent        Boolean   @default(false)
  variantName     String?
  name            String
  price           Decimal   @db.Decimal(18, 4)
  wholesalePrice  Decimal?  @db.Decimal(18, 4)
  cost            Decimal   @default(0) @db.Decimal(18, 4)
  stock           Float     @default(0)   // quantity — stays Float
  barcode         String?
  barcodeAliases  String[]
  /// SPRINT-1: "tracked" (stock + lots enforced) | "untracked" (made to order: no stock, no lots)
  stockPolicy     String   @default("tracked")
  /// SPRINT-1: +1 on every stock-policy change (server side); sale lines carry the version they were sold under
  stockPolicyVersion   Int       @default(1)
  stockPolicyChangedAt DateTime?
  /// SPRINT-1: server-owned [{version, policy, from}] — the policy each version stood for
  stockPolicyHistory   Json      @default("[]")
  /// SPRINT-1: current policy revision id (minted once by whoever changed it; "initial" = as created)
  stockPolicyRev       String    @default("initial")
  /// Café batch: false = an ingredient (kept in stock, received and counted, never offered for sale)
  sellable        Boolean   @default(true)
  /// Café batch: the unit its stock, lots, counts, waste and recipes use: unit | g | ml
  stockUnit       String    @default("unit")
  /// Café batch: how it is usually bought (unit | pack | g | kg | ml | L) and how many stock units one holds
  purchaseUnit     String?
  unitsPerPurchase Decimal?  @db.Decimal(18, 4)
  /// Café batch: the modifier groups offered with it, in order (ModifierGroup.id)
  modifierGroupIds String[]  @default([])
  /// Café batch: the current recipe revision of a "recipe" product (RecipeRevision.id); old revisions stay
  recipeRev        String?
  category        String
  accent          String    @default("emerald")
  favorite        Boolean   @default(false)
  reorderPoint    Int?
  reorderQuantity Int?
  supplierId      String?
  supplierName    String?
  expiryDate      String?
  image           String?
  archived        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  batches          InventoryBatch[]
  adjustments      StockAdjustment[]
  stockCountLines  StockCountLine[]
  stockMovements   StockMovement[]

  @@unique([tenantId, barcode])
  @@unique([tenantId, syncId])
  @@index([tenantId, category])
  @@index([tenantId, name])
  @@index([tenantId, parentId])
}

model Sale {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  saleNumber    String
  paymentMethod SalePaymentMethod
  customerId    String?
  customerName  String?
  subtotal      Decimal          @db.Decimal(18, 4)
  discountTotal Decimal?         @db.Decimal(18, 4)
  tax           Decimal          @db.Decimal(18, 4)
  total         Decimal          @db.Decimal(18, 4)
  cost          Decimal          @default(0) @db.Decimal(18, 4)
  profit        Decimal          @default(0) @db.Decimal(18, 4)
  soldAtCost    Boolean          @default(false)
  cashier       String
  cashierId     String?
  /// Who voided it (the seller above is never changed by a void), when, and how it is known.
  voidedById      String?
  voidedByName    String?
  voidedAt        DateTime?
  voidAttribution Json?
  /// Operational readiness (lib/attribution.ts): how the actor of this record is known — { basis: verified |
  /// offline-claimed | claimed | reviewed | system | unattributed, approver?, reviewer?, opId }. Written by the
  /// server when it applies the operation (never taken from the client); null for records made before it existed.
  attribution   Json?
  shiftId       String?
  shiftNumber   String?
  payableLbp    Decimal?         @db.Decimal(18, 4)
  status        SaleStatus       @default(Completed)
  /// REFUND-INTEGRITY-1: bumped inside every refund/void transaction so concurrent
  /// refunds of the same sale serialize on this row's lock.
  refundVersion Int              @default(0)
  createdAt     DateTime         @default(now())

  items      SaleItem[]
  refunds    SaleRefund[]
  tender     SaleTender?

  @@index([tenantId, saleNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, status, createdAt])
}

model SaleItem {
  id       String  @id @default(uuid())
  saleId   String
  sale     Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  productName String
  barcode   String
  quantity  Float                    // quantity — stays Float
  unitPrice Decimal @db.Decimal(18, 4)
  total     Decimal @db.Decimal(18, 4)
  cost      Decimal @default(0) @db.Decimal(18, 4)
  /// REFUND-INTEGRITY-1: client-stamped line identity (null = legacy line, pooled per product).
  lineId    String?
  lineIndex Int?
  /// Lots actually consumed by the server for this line: [{batchId|null, quantity, unitCost?}].
  batchAllocations Json?

  @@unique([saleId, lineId])
  @@index([productId])
  /// SPRINT-1: the product's stock policy when sold; refunds/voids restore stock only for "tracked" lines
  stockPolicy      String   @default("tracked")
  /// SPRINT-1: set when the sale-time policy differed from (or could not be established against) the product's
  /// policy at sync time: "changed" | "unknown". Visible conflict for managers (audit sale.stock_policy_conflict).
  stockPolicyConflict String?
  /// SPRINT-1: the policy revision this line was sold under
  stockPolicyRev      String?
  /// Café batch: the options chosen, as sold (immutable snapshot): [{groupId, groupName, optionId, name, nameAr, priceDelta}]
  modifiers        Json?
  /// Café batch: the preparation note, and the product's own price before options
  note             String?
  basePrice        Decimal?  @db.Decimal(18, 4)
  /// Café batch: the recipe revision the drink was made with, and what the server consumed for it:
  /// [{ingredientSyncId, productId, name, unit, quantity, allocations: [{batchId, quantity, unitCost}], cost, costKnown}]
  recipeRev        String?
  consumption      Json?
  /// Café batch: known | partial | unknown (ingredient cost); null for lines without a recipe
  costStatus       String?
  /// Café batch: set when the sale-time recipe or options could not be applied cleanly (visible to managers)
  recipeConflict   String?
  modifierConflict String?
}

model SaleTender {
  id             String  @id @default(uuid())
  saleId         String  @unique
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  currency       String
  exchangeRate   Decimal @db.Decimal(18, 4)
  paidUsd        Decimal @default(0) @db.Decimal(18, 4)
  paidLbp        Decimal @default(0) @db.Decimal(18, 4)
  paidTotalUsd   Decimal @db.Decimal(18, 4)
  paidTotalLbp   Decimal @db.Decimal(18, 4)
  changeUsd      Decimal @default(0) @db.Decimal(18, 4)
  changeLbp      Decimal @default(0) @db.Decimal(18, 4)
  changeCurrency String
}

model SaleRefund {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  refundNumber String
  saleId       String
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleNumber   String
  customerId   String?
  customerName String?
  method       RefundMethod
  reason       String
  total        Decimal      @db.Decimal(18, 4)
  cashier      String
  cashierId    String?
  /// Operational readiness (lib/attribution.ts): how the actor of this record is known — { basis: verified |
  /// offline-claimed | claimed | reviewed | system | unattributed, approver?, reviewer?, opId }. Written by the
  /// server when it applies the operation (never taken from the client); null for records made before it existed.
  attribution   Json?
  shiftId      String?
  shiftNumber  String?
  /// REFUND-INTEGRITY-1: original sale rate (null when the sale recorded none — never invented).
  exchangeRate Decimal?     @db.Decimal(18, 4)
  rateSource   String?
  createdAt    DateTime     @default(now())

  items RefundItem[]

  @@index([tenantId, refundNumber])
  @@index([tenantId, saleId])
}

model RefundItem {
  id          String     @id @default(uuid())
  refundId    String
  refund      SaleRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  productId   Int
  productName String
  barcode     String
  quantity    Float                         // quantity — stays Float
  unitPrice   Decimal    @db.Decimal(18, 4)
  cost        Decimal?   @db.Decimal(18, 4)
  total       Decimal    @db.Decimal(18, 4)
  /// REFUND-INTEGRITY-1: sale line refunded (lineId or legacy-product:<id>) and lots restored.
  saleLineId       String?
  batchAllocations Json?
}

model Customer {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  mobile      String
  pin         String   @default("")
  creditLimit Decimal  @default(0) @db.Decimal(18, 4)
  isWholesale  Boolean  @default(false)
  sellAtCost   Boolean  @default(false)
  notes       String   @default("")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  debtSales     DebtSale[]
  debtPayments  DebtPayment[]
  deliveryOrders DeliveryOrder[]

  @@unique([tenantId, name])
  @@index([tenantId, mobile])
}

model DebtSale {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  saleNumber    String
  /// The sale this debt belongs to (immutable id). NULL for rows written before
  /// the link existed whose sale could not be identified unambiguously.
  saleId        String?
  subtotal      Decimal  @db.Decimal(18, 4)
  discountTotal Decimal? @db.Decimal(18, 4)
  tax           Decimal  @db.Decimal(18, 4)
  total         Decimal  @db.Decimal(18, 4)
  recordedById   String?
  recordedByName String?
  /// Operational readiness (lib/attribution.ts): how the actor of this record is known — { basis: verified |
  /// offline-claimed | claimed | reviewed | system | unattributed, approver?, reviewer?, opId }. Written by the
  /// server when it applies the operation (never taken from the client); null for records made before it existed.
  attribution   Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, customerId])
  @@index([tenantId, saleId])
  @@index([tenantId, createdAt])
}

model DebtPayment {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  amount      Decimal  @db.Decimal(18, 4)
  method      String
  reference   String   @default("")
  recordedById   String?
  recordedByName String?
  /// Operational readiness (lib/attribution.ts): how the actor of this record is known — { basis: verified |
  /// offline-claimed | claimed | reviewed | system | unattributed, approver?, reviewer?, opId }. Written by the
  /// server when it applies the operation (never taken from the client); null for records made before it existed.
  attribution   Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  mobile    String   @default("")
  contact   String   @default("")
  address   String   @default("")
  notes     String   @default("")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  supplierPayments SupplierPayment[]
  inventoryBatches InventoryBatch[]

  @@unique([tenantId, name])
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  poNumber      String
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  supplierName  String
  status        PurchaseOrderStatus @default(Draft)
  paymentStatus PaymentStatus       @default(Unpaid)
  invoiceNumber String              @default("")
  note          String              @default("")
  total         Decimal             @db.Decimal(18, 4)
  paidTotal     Decimal             @default(0) @db.Decimal(18, 4)
  createdBy     String
  createdById   String?
  /// Operational readiness (lib/attribution.ts): how the actor of this record is known — { basis: verified |
  /// offline-claimed | claimed | reviewed | system | unattributed, approver?, reviewer?, opId }. Written by the
  /// server when it applies the operation (never taken from the client); null for records made before it existed.
  attribution   Json?
  shiftId       String?
  shiftNumber   String?
  createdAt     DateTime            @default(now())
  receivedAt    DateTime?

  items PurchaseOrderItem[]

  @@index([tenantId, poNumber])
  @@index([tenantId, supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productName     String
  barcode         String        @default("")
  quantity        Float
  unitCost        Decimal       @default(0) @db.Decimal(18, 4)
  unitPrice       Decimal       @default(0) @db.Decimal(18, 4)
  total           Decimal       @db.Decimal(18, 4)

  @@index([tenantId, purchaseOrderId])
}

model SupplierPayment {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  supplierId          String
  supplier            Supplier @relation(fields: [supplierId], references: [id])
  supplierName        String
  purchaseOrderId     String?
  purchaseOrderNumber String?
  amount              Decimal  @db.Decimal(18, 4)
  method              String
  reference           String   @default("")
  recordedBy          String
  recordedById        String?
  /// Operational readiness (lib/attribution.ts): how the actor of this record is known — { basis: verified |
  /// offline-claimed | claimed | reviewed | system | unattributed, approver?, reviewer?, opId }. Written by the
  /// server when it applies the operation (never taken from the client); null for records made before it existed.
  attribution   Json?
  shiftId             String?
  shiftNumber         String?
  createdAt           DateTime @default(now())

  @@index([tenantId, supplierId])
}

model Shift {
  id                String      @id @default(uuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  shiftNumber       String
  status            ShiftStatus @default(Open)
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  openingFloatUsd   Decimal?    @default(0) @db.Decimal(18, 4)
  cashSalesUsd      Decimal?    @db.Decimal(18, 4)
  cashRefundsUsd    Decimal?    @db.Decimal(18, 4)
  cashExpensesUsd   Decimal?    @db.Decimal(18, 4)
  supplierPaymentsUsd Decimal?  @db.Decimal(18, 4)
  expectedCashUsd   Decimal?    @db.Decimal(18, 4)
  closingCashUsd    Decimal?    @db.Decimal(18, 4)
  differenceUsd     Decimal?    @db.Decimal(18, 4)
  openedById        String
  openedByName      String
  openedBy          StaffUser   @relation("ShiftOpener", fields: [openedById], references: [id])
  closedById        String?
  closedByName      String?
  closedBy          StaffUser?  @relation("ShiftCloser", fields: [closedById], references: [id])
  notes             String?
  /// how the opener and the closer are known (lib/attribution.ts); null before it existed
  openAttribution   Json?
  closeAttribution  Json?

  @@index([tenantId, shiftNumber])
  @@index([tenantId, status])
}

model AuditEvent {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  action    String
  entity    String
  summary   String
  metadata  Json?
  userId    String
  userName  String
  userRole  UserRole
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
}

model Expense {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  expenseNumber String
  vendor        String
  category      String
  amount        Decimal  @db.Decimal(18, 4)
  paymentMethod String
  invoiceNumber String   @default("")
  note          String   @default("")
  recordedBy    String
  recordedById  String?
  /// Operational readiness (lib/attribution.ts): how the actor of this record is known — { basis: verified |
  /// offline-claimed | claimed | reviewed | system | unattributed, approver?, reviewer?, opId }. Written by the
  /// server when it applies the operation (never taken from the client); null for records made before it existed.
  attribution   Json?
  recordedByUser StaffUser? @relation(fields: [recordedById], references: [id])
  shiftId       String?
  shiftNumber   String?
  createdAt     DateTime @default(now())

  @@index([tenantId, expenseNumber])
  @@index([tenantId, createdAt])
}

model InventoryBatch {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  batchNumber         String
  productId           Int
  product             Product              @relation(fields: [productId], references: [id])
  productName         String
  barcode             String
  initialQuantity     Float                     // quantity — stays Float
  quantityRemaining   Float                     // quantity — stays Float
  unitCost            Decimal  @db.Decimal(18, 4)
  unitPrice           Decimal  @db.Decimal(18, 4)
  expiryDate          String?
  supplierId          String?
  supplier            Supplier?            @relation(fields: [supplierId], references: [id])
  supplierName        String?
  purchaseOrderNumber String?
  receivedAt          DateTime             @default(now())
  // POS-SYNC-AUTHORITY-1: mutation timestamp so incremental sync surfaces
  // quantityRemaining/status changes (a sale consuming a batch). receivedAt is
  // set once and never changes, so it alone can't drive incremental pull.
  updatedAt           DateTime             @updatedAt
  status              InventoryBatchStatus @default(Open)
  receivedById        String?
  receivedByName      String?
  /// Café batch: what the invoice said: bought in purchase units at an actual price per purchase unit; the
  /// stock quantity and unitCost above are derived from it (unitsPerPurchase stock units per purchase unit)
  purchaseUnit        String?
  purchaseQuantity    Decimal? @db.Decimal(18, 4)
  unitsPerPurchase    Decimal? @db.Decimal(18, 4)
  purchasePrice       Decimal? @db.Decimal(18, 4)
  supplierReference   String?
  /// Operational readiness (lib/attribution.ts): how the actor of this record is known — { basis: verified |
  /// offline-claimed | claimed | reviewed | system | unattributed, approver?, reviewer?, opId }. Written by the

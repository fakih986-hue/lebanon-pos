{
  "name": "lebanonpos",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "dev:api": "pnpm --dir apps/api dev",
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "dev:admin": "pnpm --dir apps/admin dev",
    "dev:ordering": "pnpm --dir apps/ordering dev",
    "dev:driver": "pnpm --dir apps/driver dev",
    "web": "pnpm --dir apps/desktop dev",
    "build": "pnpm --dir apps/desktop build",
    "build:api": "pnpm --dir apps/api build",
    "build:desktop": "pnpm --dir apps/desktop build",
    "build:admin": "pnpm --dir apps/admin build",
    "build:ordering": "pnpm --dir apps/ordering build",
    "build:driver": "pnpm --dir apps/driver build",
    "build:all": "pnpm build:api && pnpm build:desktop && pnpm build:admin && pnpm build:ordering && pnpm build:driver",
    "lint": "pnpm --dir apps/desktop lint",
    "test:api": "pnpm --dir apps/api test",
    "test:desktop": "pnpm --dir apps/desktop test",
    "test:all": "pnpm test:api && pnpm test:desktop",
    "typecheck:api": "pnpm --dir apps/api exec tsc --noEmit",
    "typecheck:desktop": "pnpm --dir apps/desktop exec tsc -p tsconfig.app.json --noEmit",
    "typecheck:admin": "pnpm --dir apps/admin exec tsc -b",
    "typecheck:ordering": "pnpm --dir apps/ordering exec tsc -b",
    "typecheck:driver": "pnpm --dir apps/driver exec tsc -b",
    "typecheck:all": "pnpm typecheck:api && pnpm typecheck:desktop && pnpm typecheck:admin && pnpm typecheck:ordering && pnpm typecheck:driver",
    "electron:build":   "tsc -p apps/electron",
    "electron:start":   "electron apps/electron/dist/main.js",
    "electron:dev":     "pnpm electron:build && electron apps/electron/dist/main.js",
    "electron:package": "pnpm build:api && pnpm build:admin && pnpm build:desktop && node scripts/copy-spas.mjs && pnpm --dir apps/api bundle && pnpm --dir apps/electron exec electron-builder --win",
    "electron:icon":    "node apps/electron/scripts/generate-icon.mjs"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^24.12.4",
    "electron": "42.2.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# LebanonPOS — Environment Variables
# Copy this file to .env and fill in the values before starting the server.
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# LOCAL SERVER MODE
# Use these settings on the laptop/PC that runs the API + PostgreSQL locally.
# All other devices on the same WiFi connect to this machine via browser.
# ───────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (local install)
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/lebanonpos"

# Strong random secret — minimum 32 characters (used to sign login tokens)
JWT_SECRET="REPLACE_WITH_32_CHAR_RANDOM_STRING"

# Comma-separated list of allowed origins (this machine + any LAN clients)
# Replace 192.168.1.X with your server machine's actual local IP
CORS_ORIGINS="http://localhost:3001,http://192.168.1.X:3001"

PORT=3001
NODE_ENV=production

# ── Cloud sync bridge (local server only — do NOT set these on Railway) ────────

# Set to "true" to activate the cloud sync bridge background service
IS_LOCAL_SERVER=true

# Your Railway deployment URL (get this from Railway after deploying)
CLOUD_API_URL=https://your-app.railway.app

# Shared secret — must match CLOUD_API_KEY set in Railway environment variables
CLOUD_API_KEY=REPLACE_WITH_ANOTHER_32_CHAR_RANDOM_STRING

# Tenant UUID — get this from the Railway API response when you create your first tenant:
#   POST https://your-app.railway.app/api/auth/tenant/setup
#   Copy "tenant.id" from the JSON response
CLOUD_TENANT_ID=paste-tenant-uuid-from-railway-setup-response


# ───────────────────────────────────────────────────────────────────────────────
# RAILWAY CLOUD MODE
# Set these in the Railway dashboard (Variables tab), NOT in a .env file.
# ───────────────────────────────────────────────────────────────────────────────

# DATABASE_URL   → auto-set by Railway's PostgreSQL plugin (do not override)
# JWT_SECRET     → same format as above
# CORS_ORIGINS   → https://your-app.railway.app (or your custom domain)
# NODE_ENV       → production
# PORT           → 3001 (or omit — Railway sets PORT automatically)
# CLOUD_API_KEY  → SAME value as the local server's CLOUD_API_KEY above

# Do NOT set IS_LOCAL_SERVER, CLOUD_API_URL, or CLOUD_TENANT_ID on Railway.
